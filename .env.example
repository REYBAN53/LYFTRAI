# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---- Required -------------------------------------------------------------------------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
# Free Gemini keys: https://aistudio.google.com/apikey (use keys from different Google
# Cloud projects, since quota is per project).
LLM_API_KEYS=your-first-api-key,your-second-api-key

# SQLite location. docker-compose pins this to sqlite:////data/app.db (named volume).
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated CORS origins allowed to call the backend (your frontend URL(s)).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true enables the X-Simulate-Failure header on POST /chat.
ENABLE_FAILURE_SIMULATION=true

# ---- Optional -------------------------------------------------------------------------
# Any LiteLLM model string that matches your keys' provider.
LLM_MODEL=gemini/gemini-flash-lite-latest
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=1024
# How long LiteLLM's in-memory response cache keeps an entry.
LLM_CACHE_TTL_SECONDS=86400
# DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
LOG_LEVEL=INFO

# ---- Frontend -------------------------------------------------------------------------
# URL the browser uses to reach the backend (Docker frontend reads this at container start).
API_BASE_URL=http://localhost:8000
